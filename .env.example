# Deep Research — Tongyi-DeepResearch Agent
# Copy this file to .env and fill in your values

# Required: LLM provider API key (any OpenAI-compatible API)
# Options:
#   DeepSeek:   https://platform.deepseek.com/
#   OpenRouter: https://openrouter.ai/keys
#   OpenAI:     https://platform.openai.com/api-keys
API_KEY=sk-...

# Optional: API base URL (default: https://api.deepseek.com/v1)
# DeepSeek:   https://api.deepseek.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI:     https://api.openai.com/v1
BASE_URL=https://api.deepseek.com/v1

# Optional: Model (default: deepseek-v4-flash)
# MODEL=deepseek-v4-flash

# Required for web search: Serper.dev API key
# Get one at: https://serper.dev/ (free tier: ~2500 queries)
SERPER_KEY_ID=...

# Required for page reading: Jina.ai API key
# Get one at: https://jina.ai/ (free tier: 1M tokens)
JINA_API_KEYS=...

# Page summarization uses a separate LLM call.
# Defaults to the main API_KEY/BASE_URL if not set.
# SUMMARY_MODEL_NAME=deepseek-chat
# SUMMARY_API_KEY=...
# SUMMARY_API_BASE=...

# Safety limits
# MAX_TOOL_ROUNDS=50
# MAX_TOKENS=32768
# OUTPUT_DIR=output
